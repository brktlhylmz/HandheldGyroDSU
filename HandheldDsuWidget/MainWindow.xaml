<Window x:Class="HandheldDsuWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:HandheldDsuWidget.Services"
        Title="Handheld Gyro DSU"
        Width="495"
        Height="640"
        MinWidth="440"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBgWindow}"
        FontFamily="{DynamicResource FontPrimary}"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Outer Window Frame -->
    <Border Background="{DynamicResource BrushBgWindow}"
            BorderBrush="{DynamicResource BrushBorderWindow}"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Custom Window Titlebar -->
                <RowDefinition Height="Auto" />
                <!-- 1: Header Accent Line -->
                <RowDefinition Height="2" />
                <!-- 2: Main Body (Left Flutter Navigation Rail + Right Scrollable Views) -->
                <RowDefinition Height="*" />
                <!-- 3: Bottom Action Bar (Calibrate + Controller Hint) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================== -->
            <!-- 0. CUSTOM WINDOWS TITLEBAR (DRAGGABLE & SNAP COMPATIBLE)        -->
            <!-- ============================================================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBgHeader}"
                    Padding="14,10,8,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem Vector Icon -->
                    <Path Grid.Column="0"
                          Data="{DynamicResource IconBrandEmblem}"
                          Fill="{DynamicResource BrushAccentPrimary}"
                          Width="18"
                          Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />

                    <!-- App Title & Live Endpoint Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding [AppTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EngineSubtitleText"
                                   Text="UDP 0.0.0.0:26760 • IPC 127.0.0.1:26761"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontFamily="{DynamicResource FontMonospace}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Active Profile Indicator Pill in AppBar (shows 'ProfileName' or 'ProfileName *' when modified) -->
                    <Button x:Name="AppBarProfileButton"
                            Grid.Column="2"
                            Style="{DynamicResource AppGhostButtonStyle}"
                            Height="26"
                            Padding="9,0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding [AppBarProfileTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="AppBarProfileButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="AppBarProfileIcon"
                                  Data="{DynamicResource IconProfiles}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock x:Name="AppBarProfileNameText"
                                       Text="Standard Landscape"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       MaxWidth="135"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Window Control Buttons (Pin, Minimize to Tray, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                Foreground="{DynamicResource BrushStatusOnline}"
                                ToolTip="{Binding [PinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="PinButton_Click">
                            <Path Data="{DynamicResource IconPin}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="MinimizeTrayButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                ToolTip="{Binding [MinimizeTrayTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="MinimizeToTrayButton_Click">
                            <Path Data="{DynamicResource IconMinimize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="MaximizeRestoreButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                Click="MaximizeRestoreButton_Click">
                            <Path Data="{DynamicResource IconMaximize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="CloseWindowButton"
                                Style="{DynamicResource AppWindowCloseButtonStyle}"
                                ToolTip="{Binding [CloseTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="CloseButton_Click">
                            <Path Data="{DynamicResource IconClose}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Header Accent Stripe -->
            <Border Grid.Row="1" Background="{DynamicResource BrushHeaderAccentStripe}" />

            <!-- ============================================================== -->
            <!-- 2. MAIN WORKSPACE: LEFT FLUTTER NAVIGATION RAIL + RIGHT VIEWS  -->
            <!-- ============================================================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Left Flutter-Style Vertical Navigation Rail -->
                    <ColumnDefinition Width="68" />
                    <!-- Right Scrollable View Container -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION RAIL -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushBgHeader}"
                        BorderBrush="{DynamicResource BrushBorderCard}"
                        BorderThickness="0,0,1,0"
                        Padding="0,10,0,10">
                    <StackPanel VerticalAlignment="Top">
                        <RadioButton x:Name="DashboardTabButton"
                                     GroupName="MainNavRail"
                                     Style="{DynamicResource AppNavRailItemStyle}"
                                     Tag="{DynamicResource IconDashboard}"
                                     Content="{Binding [TabDashboard], Source={x:Static services:LocalizationService.Instance}}"
                                     IsChecked="True"
                                     Checked="NavTab_Checked" />

                        <RadioButton x:Name="ControllersTabButton"
                                     GroupName="MainNavRail"
                                     Style="{DynamicResource AppNavRailItemStyle}"
                                     Tag="{DynamicResource IconGamepad}"
                                     Content="{Binding [TabControllers], Source={x:Static services:LocalizationService.Instance}}"
                                     Checked="NavTab_Checked" />

                        <RadioButton x:Name="ProfilesTabButton"
                                     GroupName="MainNavRail"
                                     Style="{DynamicResource AppNavRailItemStyle}"
                                     Tag="{DynamicResource IconProfiles}"
                                     Content="{Binding [TabProfiles], Source={x:Static services:LocalizationService.Instance}}"
                                     Checked="NavTab_Checked" />

                        <RadioButton x:Name="SettingsTabButton"
                                     GroupName="MainNavRail"
                                     Style="{DynamicResource AppNavRailItemStyle}"
                                     Tag="{DynamicResource IconSettings}"
                                     Content="{Binding [TabSettings], Source={x:Static services:LocalizationService.Instance}}"
                                     Checked="NavTab_Checked" />
                    </StackPanel>
                </Border>

                <!-- RIGHT SCROLLABLE CONTENT AREA -->
                <ScrollViewer x:Name="MainScrollViewer"
                              Grid.Column="1"
                              Style="{DynamicResource AppOverlayScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,12,14,12"
                              PanningMode="VerticalOnly">
                    <Grid>
                        <!-- ====================================================== -->
                        <!-- VIEW 1: DASHBOARD                                      -->
                        <!-- ====================================================== -->
                        <StackPanel x:Name="DashboardViewPanel" Visibility="Visible">

                        <!-- Card 1: Unified Emulator Link & Live IMU Telemetry -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionConnection], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Button x:Name="CopyEndpointButton"
                                            Grid.Column="1"
                                            Style="{DynamicResource AppGhostButtonStyle}"
                                            Height="22"
                                            Padding="7,0"
                                            FontFamily="{DynamicResource FontMonospace}"
                                            FontSize="9.5"
                                            Content="127.0.0.1:26760 ⧉"
                                            ToolTip="{Binding [CopyEndpointTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                            Click="CopyEndpointButton_Click" />
                                </Grid>

                                <!-- Connection Status Bar (Single-Line Balanced Module) -->
                                <Border Style="{DynamicResource AppSubPanelStyle}" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Framed Signal Pulse Status Icon -->
                                        <Border x:Name="StatusBadgeBorder"
                                                Grid.Column="0"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushStatusOfflineDim}"
                                                BorderBrush="{DynamicResource BrushStatusOffline}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                            <Path x:Name="StatusSignalIcon"
                                                  Data="{DynamicResource IconSignalPulse}"
                                                  Stroke="{DynamicResource BrushStatusOffline}"
                                                  StrokeThickness="1.4"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock x:Name="ConnectionStatusTitle"
                                                   Grid.Column="1"
                                                   Text="{Binding [StatusWaiting], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" />

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BrushBgInput}"
                                                BorderBrush="{DynamicResource BrushBorderInput}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="PacketCounterText"
                                                       Text="{Binding [StatusReadyBadge], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushStatusOnline}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       FontWeight="Bold"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Live Gyro Radar / Crosshair Scope + 3-Column Angular Velocity Readout -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Live Gyro Crosshair / Horizon Radar Scope -->
                                    <Border Grid.Column="0"
                                            Style="{DynamicResource AppSubPanelStyle}"
                                            Height="62"
                                            Padding="0"
                                            ClipToBounds="True">
                                        <Grid>
                                            <!-- Concentric Radar Rings -->
                                            <Ellipse Width="46" Height="46"
                                                     Stroke="#222A3A"
                                                     StrokeThickness="1"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                            <Ellipse Width="22" Height="22"
                                                     Stroke="#1A202E"
                                                     StrokeThickness="1"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />

                                            <!-- Center Hairlines -->
                                            <Border Height="1"
                                                    Background="#1E2534"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch" />
                                            <Border Width="1"
                                                    Background="#1E2534"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch" />

                                            <!-- Artificial Horizon Tilt Bar (Roll) -->
                                            <Border Width="38"
                                                    Height="1.2"
                                                    Background="#4500F0FF"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <RotateTransform x:Name="RadarRollRotate" Angle="0" />
                                                </Border.RenderTransform>
                                            </Border>

                                            <!-- Live Aiming Reticle (Yaw X / Pitch Y) -->
                                            <Grid Width="14"
                                                  Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="RadarDotTranslate" X="0" Y="0" />
                                                </Grid.RenderTransform>
                                                <Ellipse x:Name="RadarDotRing"
                                                         Width="11"
                                                         Height="11"
                                                         Stroke="#9000F0FF"
                                                         StrokeThickness="1.2"
                                                         Fill="#2400F0FF"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                                <Ellipse x:Name="RadarDotCore"
                                                         Width="4"
                                                         Height="4"
                                                         Fill="{DynamicResource BrushTelemetryReadout}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 3-Column Live Angular Velocity Readout (Pitch / Yaw / Roll) -->
                                    <UniformGrid Grid.Column="2" Columns="3" Height="62">
                                        <Border Style="{DynamicResource AppSubPanelStyle}" Margin="0,0,3,0" Padding="6,6">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [AxisPitchLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="PitchValueText"
                                                           Text="+0.00°/s"
                                                           Foreground="{DynamicResource BrushTelemetryReadout}"
                                                           FontFamily="{DynamicResource FontMonospace}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{DynamicResource AppSubPanelStyle}" Margin="1.5,0,1.5,0" Padding="6,6">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [AxisYawLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="YawValueText"
                                                           Text="+0.00°/s"
                                                           Foreground="{DynamicResource BrushTelemetryReadout}"
                                                           FontFamily="{DynamicResource FontMonospace}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{DynamicResource AppSubPanelStyle}" Margin="3,0,0,0" Padding="6,6">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [AxisRollLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock x:Name="RollValueText"
                                                           Text="+0.00°/s"
                                                           Foreground="{DynamicResource BrushTelemetryReadout}"
                                                           FontFamily="{DynamicResource FontMonospace}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>

                                <!-- Accelerometer & Bias Footer -->
                                <Border Style="{DynamicResource AppSubPanelStyle}" Padding="8,5">
                                    <TextBlock x:Name="BiasStatusText"
                                               Text="ACC (X/Y/Z): 0.00, 0.00, 0.00 G   |   BIAS: +0.00, +0.00, +0.00"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               FontFamily="{DynamicResource FontMonospace}"
                                               FontSize="9.5"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: DSU Motion Stream & Full Gamepad Forwarding Toggles -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [StreamTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock x:Name="GyroToggleSubtitle"
                                                   Text="{Binding [StreamActiveDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="GyroStreamToggle"
                                              Grid.Column="1"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Click="GyroStreamToggle_Click" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,9" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [ForwardGamepadTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock x:Name="ForwardGamepadSubtitle"
                                                   Text="{Binding [ForwardGamepadDisabledDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="ForwardGamepadToggle"
                                              Grid.Column="1"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              IsChecked="False"
                                              VerticalAlignment="Center"
                                              Click="ForwardGamepadToggle_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Axis Orientation & Hold Angle Switches -->
                        <Border Style="{DynamicResource AppCardStyle}">
                            <StackPanel>
                                <!-- Header + Reset Button -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionProfileAxes], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Button x:Name="ResetAxesButton"
                                            Grid.Column="1"
                                            Style="{DynamicResource AppGhostButtonStyle}"
                                            Content="{Binding [ResetAxesButton], Source={x:Static services:LocalizationService.Instance}}"
                                            ToolTip="{Binding [ResetAxesTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                            Click="ResetAxesButton_Click" />
                                </Grid>

                                <!-- Row 1: Zero Resting Pitch Angle (0°) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgePitchOffset" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgePitchOffsetText"
                                                   Text="0°"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [PitchOffsetTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [PitchOffsetDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="PitchOffsetToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 2: Invert Pitch (X) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertX" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertXText"
                                                   Text="X"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertXTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertXDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertXToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 3: Invert Roll (Y) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertY" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertYText"
                                                   Text="Y"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertYTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertYDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertYToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 4: Invert Yaw (Z) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertZ" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertZText"
                                                   Text="Z"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertZTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertZDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertZToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 5: Swap X <-> Y Axes -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeSwapAxes" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeSwapAxesText"
                                                   Text="X⇄Y"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [SwapAxesTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [SwapAxesDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="SwapAxesToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 6: Gyro Sensitivity (Gain Multiplier) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeSensitivity" Grid.Row="0" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeSensitivityText"
                                                   Text="×"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [SensitivityTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [SensitivityDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="0"
                                            Grid.Column="2"
                                            Background="{DynamicResource BrushBgSubPanel}"
                                            BorderBrush="{DynamicResource BrushBorderInput}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="SensitivityValueText"
                                                   Text="1.0x"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <Slider x:Name="SensitivitySlider"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Style="{DynamicResource AppSliderStyle}"
                                            Minimum="0.2"
                                            Maximum="3.0"
                                            Value="1.0"
                                            SmallChange="0.1"
                                            LargeChange="0.2"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,6,0,0"
                                            ValueChanged="AxisSlider_ValueChanged" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 7: Jitter Deadzone Filter -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeDeadzone" Grid.Row="0" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeDeadzoneText"
                                                   Text="DZ"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [DeadzoneTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [DeadzoneDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <Border Grid.Row="0"
                                            Grid.Column="2"
                                            Background="{DynamicResource BrushBgSubPanel}"
                                            BorderBrush="{DynamicResource BrushBorderInput}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="DeadzoneValueText"
                                                   Text="0.0°/s"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <Slider x:Name="DeadzoneSlider"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Style="{DynamicResource AppSliderStyle}"
                                            Minimum="0.0"
                                            Maximum="3.0"
                                            Value="0.0"
                                            SmallChange="0.1"
                                            LargeChange="0.2"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,6,0,0"
                                            ValueChanged="AxisSlider_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- ====================================================== -->
                        <!-- VIEW 2: CONTROLLERS & AUTO-PROFILE BINDING             -->
                        <!-- ====================================================== -->
                        <StackPanel x:Name="ControllersViewPanel" Visibility="Collapsed">

                            <!-- Card 1: Connected & Remembered Controllers (VID:PID) -->
                            <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionControllers], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [AutoControllerTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [AutoControllerDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="AutoControllerSwitchToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Click="AutoControllerSwitchToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,2,0,8" />

                                    <!-- Dynamic List of Connected & Remembered Controller Cards -->
                                    <StackPanel x:Name="ControllersListPanel" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Emulator & Game (.exe) Auto-Profile Rules -->
                            <Border Style="{DynamicResource AppCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionEmulatorAuto], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [AutoEmulatorTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [AutoEmulatorDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="AutoEmulatorSwitchToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Click="AutoEmulatorSwitchToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,2,0,8" />

                                    <!-- Dynamic List of Emulator Rules -->
                                    <StackPanel x:Name="EmulatorRulesListPanel" />

                                    <!-- Browse & Select Emulator / Game (.exe) Button -->
                                    <Button x:Name="AddCustomExeRuleButton"
                                            Margin="0,8,0,0"
                                            Style="{DynamicResource AppSecondaryButtonStyle}"
                                            Height="32"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="AddCustomExeRuleButton_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{DynamicResource IconFolder}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding [BtnAddRule], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ====================================================== -->
                        <!-- VIEW 3: PROFILE MANAGEMENT & SHARING                   -->
                        <!-- ====================================================== -->
                        <StackPanel x:Name="ProfilesViewPanel" Visibility="Collapsed">
                            <Border Style="{DynamicResource AppCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionProfiles], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <!-- 1. Active Profile Dropdown (Auto-Apply on Selection) + Compact Trash Icon Button -->
                                    <StackPanel Margin="0,0,0,4">
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding [ProfileSelectTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />

                                            <TextBlock x:Name="ProfileStatusBadgeText"
                                                       Grid.Column="1"
                                                       Text="{Binding [ProfileBadgeSystem], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="ProfileComboBox"
                                                      Grid.Column="0"
                                                      Style="{DynamicResource AppComboBoxStyle}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Name"
                                                      SelectionChanged="ProfileComboBox_SelectionChanged" />

                                            <Button x:Name="DeleteProfileButton"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource AppGhostButtonStyle}"
                                                    ToolTip="{Binding [DeleteProfileTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                                    Height="30"
                                                    Padding="0"
                                                    Foreground="{DynamicResource BrushStatusOffline}"
                                                    Click="DeleteProfileButton_Click">
                                                <Path Data="{DynamicResource IconTrash}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" />
                                            </Button>
                                        </Grid>

                                        <TextBlock x:Name="ProfileDescriptionText"
                                                   Text="{Binding [ProfileSelectDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="9.5"
                                                   TextWrapping="Wrap"
                                                   Margin="1,5,0,0" />
                                    </StackPanel>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 2. Save Current Settings as New Profile -->
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding [SaveProfileTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Margin="0,0,0,5" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="NewProfileNameTextBox"
                                                     Grid.Column="0"
                                                     Style="{DynamicResource AppTextBoxStyle}"
                                                     FontFamily="{DynamicResource FontPrimary}"
                                                     Foreground="{DynamicResource BrushTextPrimary}"
                                                     FontWeight="Normal"
                                                     FontSize="11.5"
                                                     HorizontalContentAlignment="Left"
                                                     Tag="{Binding [SaveProfilePlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                                     Height="30"
                                                     KeyDown="NewProfileNameTextBox_KeyDown" />

                                            <Button x:Name="SaveProfileButton"
                                                    Grid.Column="2"
                                                    Style="{DynamicResource AppSecondaryButtonStyle}"
                                                    Height="30"
                                                    Padding="12,0"
                                                    Click="SaveProfileButton_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{DynamicResource IconPlus}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [BtnSaveProfile], Source={x:Static services:LocalizationService.Instance}}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,12" />

                                    <!-- 3. Clean 2-Column File Sharing Row: Import (.JSON) & Export (.JSON) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="ImportProfileButton"
                                                Grid.Column="0"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                FontSize="10.5"
                                                Height="32"
                                                Padding="8,0"
                                                Click="ImportProfileButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconImport}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding [BtnImportFile], Source={x:Static services:LocalizationService.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="ExportProfileButton"
                                                Grid.Column="2"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                FontSize="10.5"
                                                Height="32"
                                                Padding="8,0"
                                                Click="ExportProfileButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconExport}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding [BtnExportFile], Source={x:Static services:LocalizationService.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ====================================================== -->
                        <!-- VIEW 4: SYSTEM & NETWORK SETTINGS                      -->
                        <!-- ====================================================== -->
                        <StackPanel x:Name="SettingsViewPanel" Visibility="Collapsed">

                            <!-- Settings Card 1: Interface Language -->
                            <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionLanguage], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [LanguageTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding [LanguageDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <ComboBox x:Name="LanguageComboBox"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppComboBoxStyle}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Settings Card 2: Network & DSU UDP Port -->
                            <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionNetwork], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding [PortTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock x:Name="PortStatusSubtitle"
                                                       Text="{Binding [PortDefaultDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBox x:Name="PortTextBox"
                                                 Grid.Column="1"
                                                 Style="{DynamicResource AppTextBoxStyle}"
                                                 Text="26760"
                                                 Height="30"
                                                 KeyDown="PortTextBox_KeyDown" />

                                        <Button x:Name="ApplyPortButton"
                                                Grid.Column="3"
                                                Style="{DynamicResource AppSecondaryButtonStyle}"
                                                Content="{Binding [ApplyButton], Source={x:Static services:LocalizationService.Instance}}"
                                                Height="30"
                                                Click="ApplyPortButton_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 5-8 Controller Secondary Cluster Port Toggle (UDP 26762) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [ClusterPortTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [ClusterPortDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="MultiPortClusterToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Click="MultiPortClusterToggle_Click" />
                                    </Grid>

                                    <!-- Customizable Secondary Cluster Port Input Row (visible only when cluster is active) -->
                                    <StackPanel x:Name="SecondaryPortRowGrid" Visibility="Collapsed">
                                        <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding [SecondaryPortTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5" />
                                                <TextBlock x:Name="SecondaryPortStatusSubtitle"
                                                           Text="{Binding [SecondaryPortDefaultDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           FontSize="9.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBox x:Name="SecondaryPortTextBox"
                                                     Grid.Column="1"
                                                     Style="{DynamicResource AppTextBoxStyle}"
                                                     Text="26762"
                                                     Height="30"
                                                     KeyDown="SecondaryPortTextBox_KeyDown" />

                                            <Button x:Name="ApplySecondaryPortButton"
                                                    Grid.Column="3"
                                                    Style="{DynamicResource AppSecondaryButtonStyle}"
                                                    Content="{Binding [ApplyButton], Source={x:Static services:LocalizationService.Instance}}"
                                                    Height="30"
                                                    Click="ApplySecondaryPortButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Settings Card 3: System & Tray Behavior -->
                            <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionSystem], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <!-- 1. Launch on Windows Startup -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [StartupTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock x:Name="StartupToggleSubtitle"
                                                       Text="{Binding [StartupDisabledDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="StartupToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Click="StartupToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 2. Close ('✕') Button Minimizes to System Tray -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [CloseToTrayTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [CloseToTrayDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="CloseToTrayToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Click="CloseToTrayToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 3. Show Automatically with Xbox Game Bar (Win + G) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [GameBarOverlayTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [GameBarOverlayDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="GameBarOverlayToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Click="GameBarOverlayToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 4. In-Game HUD Overlay Notifications -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [HudNotificationsTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [HudNotificationsDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="HudNotificationsToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Click="HudNotificationsToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 5. Stationary (Tabletop) Calibration Guard -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [TabletopCalibGuardTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [TabletopCalibGuardDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="TabletopCalibrationGuardToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Click="TabletopCalibrationGuardToggle_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Settings Card 4: Data & Maintenance Shortcuts -->
                            <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionDataMaintenance], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding [DataMaintenanceDesc], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               FontSize="9.5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="OpenDataFolderButton"
                                                Grid.Column="0"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                FontSize="10"
                                                Height="32"
                                                Padding="8,0"
                                                Click="OpenDataFolderButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconFolder}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding [BtnOpenDataFolder], Source={x:Static services:LocalizationService.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="ResetAllSettingsButton"
                                                Grid.Column="2"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                Foreground="{DynamicResource BrushStatusOffline}"
                                                FontSize="10"
                                                Height="32"
                                                Padding="8,0"
                                                Click="ResetAllSettingsButton_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource IconReset}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding [BtnResetAllSettings], Source={x:Static services:LocalizationService.Instance}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Settings Card 5: Developer Options & Diagnostics -->
                            <Border Style="{DynamicResource AppCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushTelemetryReadout}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionDeveloperOptions], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}"
                                                   Foreground="{DynamicResource BrushTelemetryReadout}" />
                                    </StackPanel>

                                    <!-- 1. Virtual Controller & Multi-Slot Simulator -->
                                    <TextBlock Text="{Binding [DevSimControllerTitle], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               FontWeight="SemiBold"
                                               FontSize="11.5" />
                                    <TextBlock Text="{Binding [DevSimControllerDesc], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               FontSize="9.5"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,8" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="DevSimControllerComboBox"
                                                  Grid.Column="0"
                                                  Style="{DynamicResource AppComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Tag="dualsense" Content="{Binding [DevSimPresetDualSense], Source={x:Static services:LocalizationService.Instance}}" />
                                            <ComboBoxItem Tag="switchpro" Content="{Binding [DevSimPresetSwitchPro], Source={x:Static services:LocalizationService.Instance}}" />
                                            <ComboBoxItem Tag="legiongo" Content="{Binding [DevSimPresetLegionGo], Source={x:Static services:LocalizationService.Instance}}" />
                                            <ComboBoxItem Tag="cluster4" Content="{Binding [DevSimPresetCluster4], Source={x:Static services:LocalizationService.Instance}}" />
                                            <ComboBoxItem Tag="cluster8" Content="{Binding [DevSimPresetCluster8], Source={x:Static services:LocalizationService.Instance}}" />
                                        </ComboBox>

                                        <Button x:Name="DevSimInjectButton"
                                                Grid.Column="2"
                                                Style="{DynamicResource AppSecondaryButtonStyle}"
                                                Content="{Binding [BtnDevSimInject], Source={x:Static services:LocalizationService.Instance}}"
                                                Height="30"
                                                Padding="10,0"
                                                Click="DevSimInjectButton_Click" />

                                        <Button x:Name="DevSimClearButton"
                                                Grid.Column="4"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                Content="{Binding [BtnDevSimClear], Source={x:Static services:LocalizationService.Instance}}"
                                                Height="30"
                                                Padding="10,0"
                                                Click="DevSimClearButton_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 2. Synthetic Gyro Wave Generator -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [DevSyntheticWaveTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [DevSyntheticWaveDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="DevSyntheticWaveToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Click="DevSyntheticWaveToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 3. Built-in DSU Loopback Client & UDP Slot Inspector -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [DevLoopbackTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [DevLoopbackDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox x:Name="DevLoopbackClientToggle"
                                                  Grid.Column="1"
                                                  Style="{DynamicResource AppToggleSwitchStyle}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Click="DevLoopbackClientToggle_Click" />
                                    </Grid>

                                    <Border Style="{DynamicResource AppSubPanelStyle}" Padding="8,5" Margin="0,8,0,0">
                                        <TextBlock x:Name="DevLoopbackStatusText"
                                                   Text="{Binding [DevLoopbackIdleStatus], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTelemetryReadout}"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   FontSize="9.5"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Border Style="{DynamicResource AppRowDividerStyle}" Margin="0,10,0,10" />

                                    <!-- 4. In-Game HUD Overlay Preview -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding [DevHudTestTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding [DevHudTestDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button x:Name="DevTestHudButton"
                                                Grid.Column="1"
                                                Style="{DynamicResource AppGhostButtonStyle}"
                                                Content="{Binding [BtnDevHudTest], Source={x:Static services:LocalizationService.Instance}}"
                                                FontSize="9.5"
                                                Height="30"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                Click="DevTestHudButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- FLOATING IN-APP SNACKBAR / TOAST OVERLAY -->
                <Border x:Name="AppSnackbarBorder"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="16,0,16,10"
                        Background="#F513161E"
                        BorderBrush="{DynamicResource BrushBorderInput}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AppSnackbarTranslate" Y="14" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AppSnackbarAccentBar"
                                Grid.Column="0"
                                Width="3.5"
                                CornerRadius="2"
                                Background="{DynamicResource BrushStatusOnline}"
                                Margin="0,1,10,1" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AppSnackbarTitleText"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       FontSize="11.5"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="AppSnackbarMessageText"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontFamily="{DynamicResource FontMonospace}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- 3. BOTTOM ACTION BAR (CALIBRATE + CONTROLLER HINT)             -->
            <!-- ============================================================== -->
            <Border Grid.Row="3"
                    Background="{DynamicResource BrushBgHeader}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10,14,10">
                <StackPanel>
                    <Button x:Name="CalibrateButton"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            ToolTip="{Binding [CalibrateTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="CalibrateButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconCrosshair}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="CalibrateButtonText"
                                       Text="{Binding [CalibrateButton], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding [GamepadHint], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontFamily="{DynamicResource FontMonospace}"
                               FontSize="9.5"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
