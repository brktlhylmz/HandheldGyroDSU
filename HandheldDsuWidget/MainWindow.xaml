<Window x:Class="HandheldDsuWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:HandheldDsuWidget.Services"
        Title="Handheld Gyro DSU"
        Width="440"
        Height="680"
        MinWidth="380"
        MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBgWindow}"
        FontFamily="{DynamicResource FontPrimary}"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Outer Window Frame -->
    <Border Background="{DynamicResource BrushBgWindow}"
            BorderBrush="{DynamicResource BrushBorderWindow}"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Custom Window Titlebar -->
                <RowDefinition Height="Auto" />
                <!-- 1: Header Accent Line -->
                <RowDefinition Height="2" />
                <!-- 2: Top Navigation Tabs (Dashboard / Settings) -->
                <RowDefinition Height="Auto" />
                <!-- 3: Scrollable View Content (Fits any small handheld screen) -->
                <RowDefinition Height="*" />
                <!-- 4: Bottom Action Bar (Calibrate + Controller Hint) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================== -->
            <!-- 0. CUSTOM WINDOWS TITLEBAR (DRAGGABLE & SNAP COMPATIBLE)        -->
            <!-- ============================================================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushBgHeader}"
                    Padding="14,10,8,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Emblem Vector Icon -->
                    <Path Grid.Column="0"
                          Data="{DynamicResource IconBrandEmblem}"
                          Fill="{DynamicResource BrushAccentPrimary}"
                          Width="18"
                          Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0" />

                    <!-- App Title & Live Endpoint Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [AppTitle], Source={x:Static services:LocalizationService.Instance}}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontSize="13"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="EngineSubtitleText"
                                   Text="UDP 0.0.0.0:26760 • IPC 127.0.0.1:26761"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontFamily="{DynamicResource FontMonospace}"
                                   FontSize="10" />
                    </StackPanel>

                    <!-- Window Control Buttons (Pin, Minimize to Tray, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                Foreground="{DynamicResource BrushStatusOnline}"
                                ToolTip="{Binding [PinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="PinButton_Click">
                            <Path Data="{DynamicResource IconPin}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="MinimizeTrayButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                ToolTip="{Binding [MinimizeTrayTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="MinimizeToTrayButton_Click">
                            <Path Data="{DynamicResource IconMinimize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="MaximizeRestoreButton"
                                Style="{DynamicResource AppWindowButtonStyle}"
                                Click="MaximizeRestoreButton_Click">
                            <Path Data="{DynamicResource IconMaximize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="CloseWindowButton"
                                Style="{DynamicResource AppWindowCloseButtonStyle}"
                                ToolTip="{Binding [CloseTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                Click="CloseButton_Click">
                            <Path Data="{DynamicResource IconClose}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11" Height="11" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Header Accent Stripe -->
            <Border Grid.Row="1" Background="{DynamicResource BrushHeaderAccentStripe}" />

            <!-- ============================================================== -->
            <!-- 2. NAVIGATION BAR (DASHBOARD / SETTINGS)                        -->
            <!-- ============================================================== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushBgHeader}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="0,0,0,1"
                    Padding="12,4,12,0">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="DashboardTabButton"
                                 Style="{DynamicResource AppNavTabStyle}"
                                 IsChecked="True"
                                 Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconDashboard}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding [TabDashboard], Source={x:Static services:LocalizationService.Instance}}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SettingsTabButton"
                                 Style="{DynamicResource AppNavTabStyle}"
                                 Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconSettings}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding [TabSettings], Source={x:Static services:LocalizationService.Instance}}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <!-- ============================================================== -->
            <!-- 3. SCROLLABLE VIEW CONTAINER (DASHBOARD & SETTINGS)             -->
            <!-- ============================================================== -->
            <ScrollViewer x:Name="MainScrollViewer"
                          Grid.Row="3"
                          Style="{DynamicResource AppOverlayScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,12,14,12"
                          PanningMode="VerticalOnly">
                <Grid>
                    <!-- ====================================================== -->
                    <!-- VIEW A: DASHBOARD                                      -->
                    <!-- ====================================================== -->
                    <StackPanel x:Name="DashboardViewPanel" Visibility="Visible">

                        <!-- Card 1: Unified Emulator Link & Live IMU Telemetry -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding [SectionConnection], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{DynamicResource AppSectionHeaderStyle}" />
                                </StackPanel>

                                <!-- Connection Status Bar (Single-Line Balanced Module) -->
                                <Border Style="{DynamicResource AppSubPanelStyle}" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Framed Signal Pulse Status Icon -->
                                        <Border x:Name="StatusBadgeBorder"
                                                Grid.Column="0"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="4"
                                                Background="{DynamicResource BrushStatusOfflineDim}"
                                                BorderBrush="{DynamicResource BrushStatusOffline}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                            <Path x:Name="StatusSignalIcon"
                                                  Data="{DynamicResource IconSignalPulse}"
                                                  Stroke="{DynamicResource BrushStatusOffline}"
                                                  StrokeThickness="1.4"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock x:Name="ConnectionStatusTitle"
                                                   Grid.Column="1"
                                                   Text="{Binding [StatusWaiting], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" />

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource BrushBgInput}"
                                                BorderBrush="{DynamicResource BrushBorderInput}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="PacketCounterText"
                                                       Text="{Binding [StatusReadyBadge], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushStatusOnline}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       FontWeight="Bold"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 3-Column Live Angular Velocity Readout (Pitch / Yaw / Roll) -->
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <Border Style="{DynamicResource AppSubPanelStyle}" Margin="0,0,4,0" Padding="8,7">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [AxisPitchLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PitchValueText"
                                                       Text="+0.00°/s"
                                                       Foreground="{DynamicResource BrushTelemetryReadout}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource AppSubPanelStyle}" Margin="2,0,2,0" Padding="8,7">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [AxisYawLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="YawValueText"
                                                       Text="+0.00°/s"
                                                       Foreground="{DynamicResource BrushTelemetryReadout}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{DynamicResource AppSubPanelStyle}" Margin="4,0,0,0" Padding="8,7">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [AxisRollLabel], Source={x:Static services:LocalizationService.Instance}}"
                                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="RollValueText"
                                                       Text="+0.00°/s"
                                                       Foreground="{DynamicResource BrushTelemetryReadout}"
                                                       FontFamily="{DynamicResource FontMonospace}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Accelerometer & Bias Footer -->
                                <Border Style="{DynamicResource AppSubPanelStyle}" Padding="8,5">
                                    <TextBlock x:Name="BiasStatusText"
                                               Text="ACC (X/Y/Z): 0.00, 0.00, 0.00 G   |   BIAS: +0.00, +0.00, +0.00"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               FontFamily="{DynamicResource FontMonospace}"
                                               FontSize="9.5"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: DSU Motion Stream Toggle -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding [StreamTitle], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                    <TextBlock x:Name="GyroToggleSubtitle"
                                               Text="{Binding [StreamActiveDesc], Source={x:Static services:LocalizationService.Instance}}"
                                               Foreground="{DynamicResource BrushTextSecondary}"
                                               FontSize="10.5"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox x:Name="GyroStreamToggle"
                                          Grid.Column="1"
                                          Style="{DynamicResource AppToggleSwitchStyle}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Click="GyroStreamToggle_Click" />
                            </Grid>
                        </Border>

                        <!-- Card 3: Axis Orientation & Hold Angle Switches -->
                        <Border Style="{DynamicResource AppCardStyle}">
                            <StackPanel>
                                <!-- Header + Reset Button -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [SectionProfileAxes], Source={x:Static services:LocalizationService.Instance}}"
                                                   Style="{DynamicResource AppSectionHeaderStyle}" />
                                    </StackPanel>

                                    <Button x:Name="ResetAxesButton"
                                            Grid.Column="1"
                                            Style="{DynamicResource AppGhostButtonStyle}"
                                            Content="{Binding [ResetAxesButton], Source={x:Static services:LocalizationService.Instance}}"
                                            ToolTip="{Binding [ResetAxesTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                            Click="ResetAxesButton_Click" />
                                </Grid>

                                <!-- Row 1: Zero Resting Pitch Angle (0°) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgePitchOffset" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgePitchOffsetText"
                                                   Text="0°"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [PitchOffsetTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [PitchOffsetDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="PitchOffsetToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 2: Invert Pitch (X) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertX" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertXText"
                                                   Text="X"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertXTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertXDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertXToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 3: Invert Roll (Y) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertY" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertYText"
                                                   Text="Y"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertYTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertYDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertYToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 4: Invert Yaw (Z) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeInvertZ" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeInvertZText"
                                                   Text="Z"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [InvertZTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [InvertZDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="InvertZToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>

                                <Border Style="{DynamicResource AppRowDividerStyle}" />

                                <!-- Row 5: Swap X <-> Y Axes -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BadgeSwapAxes" Grid.Column="0" Style="{DynamicResource AppAxisBadgeStyle}">
                                        <TextBlock x:Name="BadgeSwapAxesText"
                                                   Text="X⇄Y"
                                                   FontFamily="{DynamicResource FontMonospace}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [SwapAxesTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [SwapAxesDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="SwapAxesToggle"
                                              Grid.Column="2"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Click="AxisConfigToggle_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ====================================================== -->
                    <!-- VIEW B: SETTINGS MENU                                  -->
                    <!-- ====================================================== -->
                    <StackPanel x:Name="SettingsViewPanel" Visibility="Collapsed">

                        <!-- Settings Card 1: Interface Language -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding [SectionLanguage], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{DynamicResource AppSectionHeaderStyle}" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [LanguageTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding [LanguageDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <ComboBox x:Name="LanguageComboBox"
                                              Grid.Column="1"
                                              Style="{DynamicResource AppComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Code"
                                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Settings Card 2: Network & DSU UDP Port -->
                        <Border Style="{DynamicResource AppCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding [SectionNetwork], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{DynamicResource AppSectionHeaderStyle}" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding [PortTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock x:Name="PortStatusSubtitle"
                                                   Text="{Binding [PortDefaultDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBox x:Name="PortTextBox"
                                             Grid.Column="1"
                                             Style="{DynamicResource AppTextBoxStyle}"
                                             Text="26760"
                                             Height="30"
                                             KeyDown="PortTextBox_KeyDown" />

                                    <Button x:Name="ApplyPortButton"
                                            Grid.Column="3"
                                            Style="{DynamicResource AppSecondaryButtonStyle}"
                                            Content="{Binding [ApplyButton], Source={x:Static services:LocalizationService.Instance}}"
                                            Height="30"
                                            Click="ApplyPortButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Settings Card 3: System Integration (Start with Windows) -->
                        <Border Style="{DynamicResource AppCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="12" Background="{DynamicResource BrushAccentPrimary}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding [SectionSystem], Source={x:Static services:LocalizationService.Instance}}"
                                               Style="{DynamicResource AppSectionHeaderStyle}" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding [StartupTitle], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock x:Name="StartupToggleSubtitle"
                                                   Text="{Binding [StartupDisabledDesc], Source={x:Static services:LocalizationService.Instance}}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <CheckBox x:Name="StartupToggle"
                                              Grid.Column="1"
                                              Style="{DynamicResource AppToggleSwitchStyle}"
                                              IsChecked="False"
                                              VerticalAlignment="Center"
                                              Click="StartupToggle_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============================================================== -->
            <!-- 4. BOTTOM ACTION BAR (CALIBRATE + CONTROLLER HINT)             -->
            <!-- ============================================================== -->
            <Border Grid.Row="4"
                    Background="{DynamicResource BrushBgHeader}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10,14,10">
                <StackPanel>
                    <Button x:Name="CalibrateButton"
                            Style="{DynamicResource AppPrimaryButtonStyle}"
                            ToolTip="{Binding [CalibrateTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="CalibrateButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource IconCrosshair}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="CalibrateButtonText"
                                       Text="{Binding [CalibrateButton], Source={x:Static services:LocalizationService.Instance}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding [GamepadHint], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontFamily="{DynamicResource FontMonospace}"
                               FontSize="9.5"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
