<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================== -->
    <!-- 1. CENTRALIZED COLOR TOKENS (HARDWARE TELEMETRY DARK PALETTE)          -->
    <!-- ====================================================================== -->
    <Color x:Key="ColorBgWindow">#0B0D12</Color>
    <Color x:Key="ColorBgHeader">#0F1219</Color>
    <Color x:Key="ColorBgCard">#141821</Color>
    <Color x:Key="ColorBgSubPanel">#0E1117</Color>
    <Color x:Key="ColorBgInput">#0B0E14</Color>
    <Color x:Key="ColorBgSwitchOff">#1C2230</Color>
    <Color x:Key="ColorBgControlHover">#1E2432</Color>
    <Color x:Key="ColorBgControlPressed">#272F40</Color>
    <Color x:Key="ColorBgDisabled">#1A1E28</Color>

    <Color x:Key="ColorBorderWindow">#262C3A</Color>
    <Color x:Key="ColorBorderCard">#222836</Color>
    <Color x:Key="ColorBorderSubtle">#1E2433</Color>
    <Color x:Key="ColorBorderInput">#2E3648</Color>
    <Color x:Key="ColorBorderSwitchOff">#343E54</Color>

    <!-- Primary Accent Colors -->
    <Color x:Key="ColorAccentPrimary">#FF0032</Color>
    <Color x:Key="ColorAccentPrimaryHover">#FF2952</Color>
    <Color x:Key="ColorAccentPrimaryPressed">#CC0028</Color>
    <Color x:Key="ColorAccentDim">#380B16</Color>

    <!-- Status & Telemetry Readout Colors -->
    <Color x:Key="ColorStatusOnline">#00E676</Color>
    <Color x:Key="ColorStatusOnlineDim">#1F00E676</Color>
    <Color x:Key="ColorStatusOffline">#FF3B30</Color>
    <Color x:Key="ColorStatusOfflineDim">#24FF3B30</Color>
    <Color x:Key="ColorTelemetryReadout">#00F0FF</Color>

    <!-- Typography Colors -->
    <Color x:Key="ColorTextPrimary">#F2F5FA</Color>
    <Color x:Key="ColorTextSecondary">#8C96A8</Color>
    <Color x:Key="ColorTextMuted">#596273</Color>
    <Color x:Key="ColorTextOnAccent">#FFFFFF</Color>

    <!-- ====================================================================== -->
    <!-- 2. SEMANTIC BRUSHES                                                    -->
    <!-- ====================================================================== -->
    <SolidColorBrush x:Key="BrushBgWindow" Color="{StaticResource ColorBgWindow}" />
    <SolidColorBrush x:Key="BrushBgHeader" Color="{StaticResource ColorBgHeader}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgSubPanel" Color="{StaticResource ColorBgSubPanel}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBgSwitchOff" Color="{StaticResource ColorBgSwitchOff}" />
    <SolidColorBrush x:Key="BrushBgControlHover" Color="{StaticResource ColorBgControlHover}" />
    <SolidColorBrush x:Key="BrushBgControlPressed" Color="{StaticResource ColorBgControlPressed}" />
    <SolidColorBrush x:Key="BrushBgDisabled" Color="{StaticResource ColorBgDisabled}" />

    <SolidColorBrush x:Key="BrushBorderWindow" Color="{StaticResource ColorBorderWindow}" />
    <SolidColorBrush x:Key="BrushBorderCard" Color="{StaticResource ColorBorderCard}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderInput" Color="{StaticResource ColorBorderInput}" />
    <SolidColorBrush x:Key="BrushBorderSwitchOff" Color="{StaticResource ColorBorderSwitchOff}" />

    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryHover" Color="{StaticResource ColorAccentPrimaryHover}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryPressed" Color="{StaticResource ColorAccentPrimaryPressed}" />
    <SolidColorBrush x:Key="BrushAccentDim" Color="{StaticResource ColorAccentDim}" />

    <SolidColorBrush x:Key="BrushStatusOnline" Color="{StaticResource ColorStatusOnline}" />
    <SolidColorBrush x:Key="BrushStatusOnlineDim" Color="{StaticResource ColorStatusOnlineDim}" />
    <SolidColorBrush x:Key="BrushStatusOffline" Color="{StaticResource ColorStatusOffline}" />
    <SolidColorBrush x:Key="BrushStatusOfflineDim" Color="{StaticResource ColorStatusOfflineDim}" />
    <SolidColorBrush x:Key="BrushTelemetryReadout" Color="{StaticResource ColorTelemetryReadout}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="{StaticResource ColorTextOnAccent}" />

    <LinearGradientBrush x:Key="BrushHeaderAccentStripe" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ColorAccentPrimary}" Offset="0.0" />
        <GradientStop Color="#80FF0032" Offset="0.45" />
        <GradientStop Color="#00FF0032" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ====================================================================== -->
    <!-- 3. TYPOGRAPHY & VECTOR GEOMETRY ICONS                                  -->
    <!-- ====================================================================== -->
    <FontFamily x:Key="FontPrimary">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMonospace">Cascadia Mono, Consolas</FontFamily>

    <!-- Vector Path Geometries (16x16 ViewBox) -->
    <Geometry x:Key="IconBrandEmblem">M 2,14 L 8,2 L 11,2 L 5,14 Z M 8,14 L 14,2 L 15.5,2 L 9.5,14 Z</Geometry>
    <Geometry x:Key="IconSignalPulse">M 8,6.2 A 1.8,1.8 0 1 0 8,9.8 A 1.8,1.8 0 1 0 8,6.2 Z M 4.8,4.8 A 4.5,4.5 0 0 0 4.8,11.2 M 11.2,4.8 A 4.5,4.5 0 0 1 11.2,11.2 M 2.4,2.4 A 7.8,7.8 0 0 0 2.4,13.6 M 13.6,2.4 A 7.8,7.8 0 0 1 13.6,13.6</Geometry>
    <Geometry x:Key="IconDashboard">M 2,2 H 7 V 7 H 2 Z M 9,2 H 14 V 7 H 9 Z M 2,9 H 7 V 14 H 2 Z M 9,9 H 14 V 14 H 9 Z</Geometry>
    <Geometry x:Key="IconSettings">M 8,1 L 14,4.5 V 11.5 L 8,15 L 2,11.5 V 4.5 Z M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 Z</Geometry>
    <Geometry x:Key="IconCrosshair">M 8,1 V 4 M 8,12 V 15 M 1,8 H 4 M 12,8 H 15 M 8,4 A 4,4 0 1 1 7.99,4 Z M 8,7 A 1,1 0 1 0 8,9 A 1,1 0 1 0 8,7 Z</Geometry>
    <Geometry x:Key="IconPin">M 5,2 H 11 V 4 L 9.5,5.5 V 9 L 11.5,11 H 8.75 V 15 H 7.25 V 11 H 4.5 L 6.5,9 V 5.5 L 5,4 Z</Geometry>
    <Geometry x:Key="IconMinimize">M 3,8 H 13 V 9.5 H 3 Z</Geometry>
    <Geometry x:Key="IconMaximize">M 3,3 H 13 V 13 H 3 Z M 4.5,4.5 V 11.5 H 11.5 V 4.5 Z</Geometry>
    <Geometry x:Key="IconClose">M 3.5,2.5 L 8,7 L 12.5,2.5 L 13.5,3.5 L 9,8 L 13.5,12.5 L 12.5,13.5 L 8,9 L 3.5,13.5 L 2.5,12.5 L 7,8 L 2.5,3.5 Z</Geometry>
    <Geometry x:Key="IconTrash">M 6,2 H 10 M 3,4 H 13 M 4.5,4 L 5.2,13.5 H 10.8 L 11.5,4 M 6.8,6.5 V 11.5 M 9.2,6.5 V 11.5</Geometry>
    <Geometry x:Key="IconPlus">M 8,3 V 13 M 3,8 H 13</Geometry>
    <Geometry x:Key="IconImport">M 8,2 V 10.5 M 4.5,7.2 L 8,10.8 L 11.5,7.2 M 2.5,11.5 V 13.5 H 13.5 V 11.5</Geometry>
    <Geometry x:Key="IconExport">M 8,10.5 V 2 M 4.5,5.5 L 8,2 L 11.5,5.5 M 2.5,11.5 V 13.5 H 13.5 V 11.5</Geometry>
    <Geometry x:Key="IconGamepad">M 3.5,4.5 H 12.5 A 2.2,2.2 0 0 1 14.5,6.7 L 13.8,11.5 A 1.8,1.8 0 0 1 10.8,12.5 L 9.5,10.5 H 6.5 L 5.2,12.5 A 1.8,1.8 0 0 1 2.2,11.5 L 1.5,6.7 A 2.2,2.2 0 0 1 3.5,4.5 Z M 5,6.5 V 9.5 M 3.5,8 H 6.5 M 11,7.2 A 0.6,0.6 0 1 0 11,8.4 A 0.6,0.6 0 1 0 11,7.2 Z M 12.5,6.2 A 0.6,0.6 0 1 0 12.5,7.4 A 0.6,0.6 0 1 0 12.5,6.2 Z</Geometry>
    <Geometry x:Key="IconProfiles">M 2,4 H 14 M 5,2.2 V 5.8 M 2,8 H 14 M 11,6.2 V 9.8 M 2,12 H 14 M 7,10.2 V 13.8</Geometry>
    <Geometry x:Key="IconFolder">M 2,3.5 H 6.2 L 7.8,5.2 H 14 V 13 H 2 Z</Geometry>
    <Geometry x:Key="IconReset">M 3.2,5.5 A 5.2,5.2 0 1 1 2.8,9.2 M 3.2,2.5 V 5.8 H 6.5</Geometry>

    <!-- ====================================================================== -->
    <!-- 4. CONTROLLER / KEYBOARD FOCUS VISUAL STYLE                            -->
    <!-- ====================================================================== -->
    <Style x:Key="AppFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource BrushAccentPrimary}"
                            BorderThickness="1.5"
                            CornerRadius="5"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- 5. CONTAINERS, BADGES, DIVIDERS & SECTION HEADERS                      -->
    <!-- ====================================================================== -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderCard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppSubPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgSubPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppAxisBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource BrushBgSubPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="AppRowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushBorderSubtle}" />
        <Setter Property="Margin" Value="0,9" />
    </Style>

    <Style x:Key="AppSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================== -->
    <!-- 6. MODERN HARDWARE PILL TOGGLE SWITCH                                  -->
    <!-- ====================================================================== -->
    <Style x:Key="AppToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="50" Height="28" Background="Transparent">
                        <Border x:Name="FocusRing"
                                CornerRadius="14"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Margin="-2"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="Track"
                                Width="46"
                                Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource BrushBgSwitchOff}"
                                BorderBrush="{DynamicResource BrushBorderSwitchOff}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" />
                        <Ellipse x:Name="Thumb"
                                 Width="16"
                                 Height="16"
                                 Fill="{DynamicResource BrushTextSecondary}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="6,0,0,0"
                                 SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimaryHover}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BrushTextOnAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,6,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource BrushTelemetryReadout}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BrushTextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- 7. BUTTON STYLES (PRIMARY, SECONDARY, GHOST, NAV TABS, WINDOW CHROME)  -->
    <!-- ====================================================================== -->
    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentPrimaryHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="14,10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushAccentPrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushAccentPrimaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushTelemetryReadout}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBgDisabled}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderCard}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushBgControlHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBgControlPressed}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushAccentDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushTelemetryReadout}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBgDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppGhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushBgSubPanel}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBgControlHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushTelemetryReadout}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushAccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushBgDisabled}" />
                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderCard}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top Navigation Tab RadioButton Style -->
    <Style x:Key="AppNavTabStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="TabHoverBg"
                                Background="Transparent"
                                CornerRadius="3"
                                Margin="2,2,2,0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="12,8" />
                        <Border x:Name="ActiveIndicator"
                                Height="2.5"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                Margin="6,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter TargetName="TabHoverBg" Property="Background" Value="{DynamicResource BrushBgControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="TabHoverBg" Property="Background" Value="{DynamicResource BrushBgCard}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flutter-Style Vertical Navigation Rail Item Style -->
    <Style x:Key="AppNavRailItemStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Height="56">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <Grid Height="28">
                                <!-- Left Active Pill Bar (perfectly centered with IconPill) -->
                                <Border x:Name="LeftAccentBar"
                                        Width="3"
                                        Height="18"
                                        CornerRadius="0,2,2,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="Transparent" />

                                <!-- Flutter NavigationRail Indicator Pill -->
                                <Border x:Name="IconPill"
                                        Width="46"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Path x:Name="RailIcon"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <ContentPresenter HorizontalAlignment="Center"
                                              Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter TargetName="IconPill" Property="Background" Value="{DynamicResource BrushBgControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter TargetName="LeftAccentBar" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="IconPill" Property="Background" Value="{DynamicResource BrushAccentDim}" />
                            <Setter TargetName="IconPill" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter TargetName="RailIcon" Property="Stroke" Value="{DynamicResource BrushAccentPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titlebar Window Chrome Buttons -->
    <Style x:Key="AppWindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BrushBgControlHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BrushBgControlPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppWindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource AppWindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BrushAccentPrimaryPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- 8. INPUT CONTROLS (TEXTBOX & COMBOBOX)                                 -->
    <!-- ====================================================================== -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontMonospace}" />
        <Setter Property="Background" Value="{DynamicResource BrushBgInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTelemetryReadout}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAccentPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,2" />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontFamily="{DynamicResource FontPrimary}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       Margin="10,0,8,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource BrushBgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushBgControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushAccentDim}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnAccent}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontPrimary}" />
        <Setter Property="Background" Value="{DynamicResource BrushBgInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualStyle}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border"
                                            Background="{DynamicResource BrushBgInput}"
                                            BorderBrush="{DynamicResource BrushBorderInput}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1"
                                                  Data="M 0,0 L 4,4 L 8,0 Z"
                                                  Fill="{DynamicResource BrushAccentPrimary}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource BrushBgCard}"
                                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                        <Border x:Name="ComboFocusBorder"
                                CornerRadius="3"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboFocusBorder" Property="BorderBrush" Value="{DynamicResource BrushTelemetryReadout}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================== -->
    <!-- 9. BALANCED ERGONOMIC OVERLAY SCROLLBAR (SWEET SPOT 8PX)               -->
    <!-- ====================================================================== -->
    <Style x:Key="AppScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="ThumbBd"
                                Width="5"
                                Background="{DynamicResource BrushTextMuted}"
                                CornerRadius="2.5"
                                HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Width" Value="7" />
                            <Setter TargetName="ThumbBd" Property="CornerRadius" Value="3.5" />
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Width" Value="7" />
                            <Setter TargetName="ThumbBd" Property="CornerRadius" Value="3.5" />
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource BrushAccentPrimaryHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="8" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AppScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay ScrollViewer Template: ScrollBar sits in the dedicated right gutter and never squeezes content width -->
    <Style x:Key="AppOverlayScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Content="{TemplateBinding Content}"
                                                Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   AutomationProperties.AutomationId="VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,2,8"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
