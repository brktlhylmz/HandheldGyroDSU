<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HandheldDsuServer</RootNamespace>
    <AssemblyName>HandheldDsuServer</AssemblyName>
    <Product>HandheldGyroDSU</Product>
    <Title>HandheldGyroDSU Server</Title>
    <Version>1.0.0</Version>
    <Description>250 Hz Cemuhook DSU v1001 UDP motion server and hardware IMU engine for Windows handhelds and motion controllers.</Description>
    <SelfContained>false</SelfContained>
    <DefaultItemExcludes>$(DefaultItemExcludes);HandheldDsuWidget\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
